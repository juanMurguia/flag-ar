# Copy to .env.local for local work. On Vercel, set these in Project Settings > Environment Variables.

# Public site URL (Open Graph).
NEXT_PUBLIC_SITE_URL=https://flag.ar
# Where the flag page reads manifest.json and logos. "/files" proxies the public bucket.
# For phase 1 / local work without Supabase: run `npm run sample` and use "/sample".
NEXT_PUBLIC_FILES_BASE=/files

# Supabase. The publishable key is used only by the admin app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# hCaptcha. The defaults below are hCaptcha's public test keys (always pass). Replace for production.
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000
# Same secret, set in Supabase Auth > Attack Protection (CAPTCHA). Used by `supabase start` locally.
SUPABASE_AUTH_CAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Upstash Redis (rate limits). Required in production. Without it, dev uses an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Long random strings. Generate with: openssl rand -hex 32
IP_HASH_SALT=
CRON_SECRET=

# Origins allowed to POST to /api/upload and admin routes.
ALLOWED_ORIGINS=https://flag.ar,https://www.flag.ar

# Slack incoming webhook for alerts. Without it, alerts go to the server log.
SLACK_WEBHOOK_URL=
